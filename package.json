{
  "name": "mitsukeru-sketch",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts *.json index.html",
    "test:e2e:preview": "E2E_PREVIEW=1 playwright test",
    "ios:sync": "VITE_BASE_PATH=/ npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios",
    "ios:demo": "npm run ios:sync && node scripts/ios-demo.mjs"
  },
  "dependencies": {
    "@capacitor/core": "8.4.3",
    "@capacitor/ios": "8.4.3",
    "@huggingface/transformers": "^4.3.1",
    "lucide-react": "^0.468.0",
    "motion": "^14.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.0"
  }
}
